# Quantum-Enhanced Blockchain DSI System Configuration

# Flask Application Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
PORT=5000

# Database Configuration
DSI_DATABASE_URL=sqlite:///dsi_metadata.db
GOVERNANCE_DATABASE_URL=sqlite:///governance.db

# Hyperledger Fabric Network Configuration
FABRIC_NETWORK_PATH=/path/to/fabric/network
FABRIC_CONNECTION_PROFILE=connection-profile.yaml
FABRIC_WALLET_PATH=/path/to/wallet
FABRIC_CHANNEL_NAME=dsi-channel
FABRIC_CHAINCODE_NAME=dsi-chaincode

# Quantum Computing Configuration
QUANTUM_BACKEND=aer_simulator
IBMQ_TOKEN=your-ibm-quantum-token
QUANTUM_HUB=ibm-q
QUANTUM_GROUP=open
QUANTUM_PROJECT=main

# Governance System Configuration
GOVERNANCE_QUORUM_THRESHOLD=0.6
GOVERNANCE_APPROVAL_THRESHOLD=0.5
IPLC_VETO_ENABLED=true
PROPOSAL_EXPIRY_DAYS=7

# FAIR-CARE Metadata Configuration
METADATA_RDF_STORE=memory
DOI_PREFIX=10.5061/dsi
METADATA_VALIDATION_ENABLED=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/dsi_system.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Security Configuration
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,https://dsi-platform.org
JWT_SECRET_KEY=your-jwt-secret
JWT_EXPIRATION_HOURS=24

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@dsi-platform.org

# External Services
CALI_FUND_API_URL=https://api.califund.org
CALI_FUND_API_KEY=your-api-key
INSDC_API_URL=https://www.insdc.org/api
GENBANK_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez

# Blockchain Payment Integration
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
PAYMENT_WEBHOOK_SECRET=whsec_your_webhook_secret

# Monitoring and Analytics
ENABLE_MONITORING=true
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000
ANALYTICS_ENABLED=true

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TIMEOUT=300

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups